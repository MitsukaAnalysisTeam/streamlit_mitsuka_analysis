# このファイルを `.env` という名前でコピーして、キーを書き込む。
# `.env` は .gitignore 済みで、コミットされない。キーを書いたまま共有しないこと。
#   cp .env.example .env

# TypeSafe (Jev)。TypeSafe のコンソールで発行
TYPESAFE_API_KEY=

# OpenAI (Decisions API と、フォールバック LLM の GPT-6 Luna。どちらも gpt-6-luna)
OPENAI_API_KEY=

# Anthropic (任意。Claude Haiku 5.5 を比較するときだけ)
ANTHROPIC_API_KEY=
